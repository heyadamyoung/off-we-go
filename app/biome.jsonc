{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Generated by the TanStack router plugin; regenerated on every build.
      "!src/route-tree.gen.ts",
      // Tailwind v4 at-rules (@source, @custom-variant, import attributes)
      // are ahead of Biome's CSS parser; the file is hand-laid anyway.
      "!src/styles.css",
      // Built artifacts and native shells, not source.
      "!public",
      "!android",
      "!ios",
      "!fastlane",
      "!dist",
      "!test-results",
      "!.tanstack"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      // The house style, encoded rather than fought: no semicolons unless the
      // parser needs one, single quotes in code and double in JSX, bare arrow
      // parameters, trailing commas everywhere multiline, and the JSX `>`
      // hugging its last attribute.
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "all",
      "bracketSameLine": true
    }
  },
  "css": {
    // styles.css is the only stylesheet and it is excluded above; keep the
    // CSS tooling off so nothing reflows hand-laid one-line rules.
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "assist": {
    "actions": {
      "source": {
        // Import order here is curated (react first, then packages, then the
        // app's own layers); mechanical sorting would churn every file and
        // fight the convention.
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended",
      // Cross-file analysis: cycles and slice visibility need the project domain.
      "project": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        /* Missing dependencies stay errors. The "unnecessary" half is off:
           this codebase deliberately lists signal dependencies (a retry
           counter, the selected id, the chosen day) to say *when* an effect
           re-runs, and that is a decision, not an oversight. */
        "useExhaustiveDependencies": {
          "level": "error",
          "options": { "reportUnnecessaryDependencies": false }
        }
      },
      "suspicious": {
        // The tsconfig has full strict with no carve-outs and src carries zero
        // `any`; the linter now holds that line too.
        "noExplicitAny": "error",
        // Slices must not point back at each other, even indirectly.
        "noImportCycles": "error"
      },
      "style": {
        // Types travel as types: erasable imports, no accidental value deps.
        "useImportType": "error",
        "useExportType": "error",
        /* Guarded non-null assertions are house style under full strict —
           each `!` sits behind an explicit runtime check. Banning them here
           would only launder the same certainty through `as` casts. */
        "noNonNullAssertion": "off",
        /* className strings are built by concatenation throughout ("a " +
           (cond ? "b " : "") + "c"); templates read worse for that shape. */
        "useTemplate": "off",
        /* The vertical-slice boundary. A feature's ui/, model/ and api/ are
           internal; the only door another slice may use is the feature's
           index barrel. The source-architecture unit test enforces the same
           rule in CI — this puts the red squiggle in the editor at the moment
           the import is typed. */
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "../../*/ui/**",
                  "../../*/model/**",
                  "../../*/api/**",
                  "**/features/*/ui/**",
                  "**/features/*/model/**",
                  "**/features/*/api/**"
                ],
                "message": "Import another feature only through its index barrel (e.g. '../../map'). A slice's ui/, model/ and api/ are internal to it."
              }
            ]
          }
        }
      },
      "a11y": {
        /* Buttons that must submit already say type="submit"; the other ~100
           are onClick-driven and never sit where an implicit submit could
           fire. Retyping them all is churn without a bug behind it. */
        "useButtonType": "off",
        /* autoFocus is used deliberately and sparingly: the one field a sheet
           or editor exists to fill (stop name, sign-in email, invite code). */
        "noAutofocus": "off"
      }
    }
  },
  "overrides": [
    {
      // The sample-trip seed data is a hand-aligned table; reflowing it would
      // destroy the columns that make it reviewable.
      "includes": ["src/data.ts"],
      "formatter": { "enabled": false }
    },
    {
      // Unit tests exercise slice internals directly on purpose — the barrel
      // is the boundary for other slices, not for the tests that pin a
      // module's own behaviour. Node scripts get the same door: the seeder
      // needs the attractions API without the barrel's browser-only exports
      // (MapCanvas drags in Vite's ?worker imports, which node cannot load).
      "includes": ["tests/**", "scripts/**"],
      "linter": {
        "rules": {
          "style": { "noRestrictedImports": "off" }
        }
      }
    }
  ]
}
