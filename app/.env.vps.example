WAYFARE_DOMAIN=offwego.to
WAYFARE_ADMIN_EMAIL=owner@example.com
APPLE_TEAM_ID=R65UN25Q64
APPLE_BUNDLE_ID=ai.threadway.wayfare
ANDROID_PACKAGE_NAME=ai.threadway.wayfare
ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:replace-with-the-SHA-256-fingerprint-from-Play-App-Signing
POSTGRES_PASSWORD=generate-a-long-random-value
WAYFARE_SESSION_SECRET=generate-another-long-random-value
WAYFARE_OAUTH_SECRET=generate-a-separate-oauth-signing-secret
WAYFARE_OIDC_ISSUER=https://auth.example.com/oidc
WAYFARE_OIDC_CLIENT_ID=copy-the-traditional-web-app-id-from-logto
WAYFARE_OIDC_CLIENT_SECRET=copy-the-traditional-web-app-secret-from-logto
# The largest single video an upload may carry, in bytes. Photographs have
# their own, much smaller, ceiling. Unset means 256 MB — about two minutes of
# 4K off a phone. Films stream straight to disk rather than through memory,
# so this is a question of storage and of how long a phone can hold a
# connection, not of how much RAM the box has.
WAYFARE_MAX_VIDEO_BYTES=268435456

# Videos are converted to H.264/AAC MP4 after upload, because an iPhone films
# HEVC that Chrome and Android will not play. The work happens in a queue
# behind the upload, never during it. How many converters this box runs; 0 on
# a web node once the work has its own machines. `WAYFARE_TRANSCODE=off`
# disables conversion entirely and stores films exactly as filmed.
WAYFARE_MEDIA_WORKERS=1
WAYFARE_TRANSCODE=on

# A film is also published as an adaptive stream: the same footage at several
# sizes, cut into segments, with a playlist the player uses to change its mind
# every few seconds. That is what keeps somebody watching when they walk out of
# hotel wifi instead of leaving them at a spinner. It costs roughly three to
# four times the storage of the film alone and several encodes rather than one,
# so a box that is already at its limit converting can be told to stop there
# with WAYFARE_VIDEO_LADDERS=0. The single MP4 is served either way.
WAYFARE_VIDEO_LADDERS=1

# Media on object storage instead of this box's volume. Leave S3_BUCKET empty
# and photographs live under UPLOAD_DIR, which is fine for one machine and is
# the thing that prevents a second. Any S3-compatible service works — R2, B2,
# MinIO, S3 itself. S3_FORCE_PATH_STYLE=true for MinIO and most self-hosted
# gateways; leave it false for S3 and R2, which is also what a CDN expects.
#
# The stack runs its own MinIO, so this can be filled in without an account
# anywhere. Turning it on is deliberately three steps rather than one, because
# the second is the one that must not be skipped:
#
#   1. docker compose up -d minio      (the bucket and the api's account are
#                                       made by minio-init on the way up)
#   2. pnpm media:migrate              (moves what is already on the volume
#                                       into the bucket; --check first)
#   3. set S3_BUCKET below and deploy  (nothing reads the volume after this)
#
# Setting S3_BUCKET without step 2 leaves every existing photograph on the
# volume with nothing pointing at it, and every trip full of grey squares.
S3_BUCKET=
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=offwego-api
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=

# The bucket minio-init makes, and the root account it makes it with. The api
# never uses the root account: minio-init gives it S3_ACCESS_KEY_ID above,
# scoped to this one bucket, so a leaked application key cannot reach the
# store's administration.
S3_BUCKET_NAME=offwego-media
MINIO_ROOT_USER=offwego
MINIO_ROOT_PASSWORD=

# How wide the window in which every reader is handed the same media URL.
#
# A signed link used to be minted off the clock, so two people opening the same
# trip a second apart got two different URLs for one photograph — a cache key
# each, and a hit rate of zero however good the cache in front of us was.
# Rounding to a window makes them identical, which is what lets an edge answer
# them all from one fetch. Zero goes back to a unique link per request.
WAYFARE_MEDIA_LINK_WINDOW=3600

# And how long anything in front of us may keep the bytes. Shorter than the
# link on purpose: a link lasts a day so an app left open keeps drawing, but a
# deleted photograph has to stop being served, and an edge holding it for a day
# would be the one thing keeping it alive.
WAYFARE_MEDIA_CACHE_SECONDS=3600
LOGTO_DOMAIN=auth.example.com
LOGTO_ADMIN_DOMAIN=auth-admin.example.com
LOGTO_POSTGRES_PASSWORD=generate-a-separate-long-random-value
LOGTO_SECRET_VAULT_KEK=generate-32-random-bytes-and-base64-encode-them
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=wayfare@example.com
SMTP_PASS_B64=base64-encoded-smtp-password
SMTP_FROM=Off We Go <wayfare@example.com>
LOG_LEVEL=info

# Connecting an Outlook mailbox (optional). Register an application in Entra ID
# with the redirect URI https://<your domain>/api/connectors/outlook/callback and
# the delegated permissions offline_access, User.Read and Mail.Read. Without
# these three the connector is simply not offered.
# Supported account types matters: the portal's default ("this directory
# only") rejects @outlook.com and other personal mailboxes with a "work
# accounts only" page. Pick "any organizational directory and personal
# Microsoft accounts", and keep the tenant below at `common`.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# Encrypts the stored refresh tokens: openssl rand -base64 32
MAILBOX_TOKEN_KEY=

# The AI assistant (optional). It answers with a personal Codex account: run
# `codex login` on your own machine, then `base64 -w0 ~/.codex/auth.json` and
# put the result in the CODEX_AUTH_JSON_B64 GitHub secret — the deploy folds
# it in here. Without it the assistant is simply not offered. The model and
# reasoning effort are plain env values, so a rename is an edit, not a release.
# gpt-5.6-luna at xhigh is verified against a ChatGPT-account Codex login.
CODEX_AUTH_JSON_B64=
WAYFARE_AI_MODEL=gpt-5.6-luna
WAYFARE_AI_REASONING=xhigh

# The routing engine needs nothing set: its coverage follows the trips. The
# api matches every stop against Geofabrik's region index and hands the engine
# the extract list; new regions download and build in the background (watch
# `docker compose logs valhalla`). Set VALHALLA_URL= (empty) to turn routing
# off entirely.
# VALHALLA_URL=http://valhalla:8002
