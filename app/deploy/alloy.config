// Ships every wayfare container's stdout to Grafana Cloud Loki, so "what did
// the server actually answer her phone?" has an answer the next time it is
// asked. One agent, read-only on the Docker socket, labels each line with its
// compose service name — query {app="offwego", service="api"} and read.

discovery.docker "wayfare" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=wayfare"]
  }
}

discovery.relabel "wayfare" {
  targets = discovery.docker.wayfare.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "wayfare" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.wayfare.output
  forward_to = [loki.write.cloud.receiver]
  labels     = { app = "offwego" }
}

loki.write "cloud" {
  endpoint {
    url = env("GRAFANA_LOKI_URL")

    basic_auth {
      username = env("GRAFANA_LOKI_USER")
      password = env("GRAFANA_LOKI_TOKEN")
    }
  }
}

// ---- traces -----------------------------------------------------------
// The api container speaks OTLP to this receiver; spans continue to Grafana
// Cloud Tempo. The Loki datasource's derived traceID field links the two.

otelcol.receiver.otlp "app" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.filter.noise.input]
  }
}

// The health probe answers docker every ten seconds for ever; its spans are
// heartbeat, not signal, and they would drown every trace search in noise.
otelcol.processor.filter "noise" {
  traces {
    span = [
      `attributes["http.route"] == "/api/health"`,
      `attributes["url.path"] == "/api/health"`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.app.input]
  }
}

otelcol.processor.batch "app" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.auth.basic "tempo" {
  username = env("GRAFANA_TEMPO_USER")
  password = env("GRAFANA_LOKI_TOKEN")
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = env("GRAFANA_TEMPO_URL")
    auth     = otelcol.auth.basic.tempo.handler
  }
}

// ---- the machine ------------------------------------------------------
// Traces exist only for requests that happen; nothing else watches the box
// they live on. Host and container metrics are the early warning for the
// quiet death — the disk filling under replays, uploads and build cache.

prometheus.exporter.unix "host" {
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  rootfs_path    = "/host/root"
  udev_data_path = "/host/root/run/udev/data"
}

prometheus.exporter.cadvisor "containers" {
  docker_host = "unix:///var/run/docker.sock"
}

prometheus.scrape "machine" {
  targets = concat(
    prometheus.exporter.unix.host.targets,
    prometheus.exporter.cadvisor.containers.targets,
  )
  forward_to      = [prometheus.remote_write.cloud.receiver]
  scrape_interval = "60s"
}

prometheus.remote_write "cloud" {
  endpoint {
    url = env("GRAFANA_PROM_URL")

    basic_auth {
      username = env("GRAFANA_PROM_USER")
      password = env("GRAFANA_LOKI_TOKEN")
    }
  }
}

// ---- the browser ------------------------------------------------------
// The Faro Web SDK posts to /collect on the app's own domain; Caddy hands it
// here. Errors and events become Loki lines, browser spans join the same
// Tempo as the server's, so one trace crosses the wire intact.

faro.receiver "web" {
  server {
    listen_address       = "0.0.0.0"
    listen_port          = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs   = [loki.write.cloud.receiver]
    traces = [otelcol.processor.batch.app.input]
  }
}
