// Ships every wayfare container's stdout to Grafana Cloud Loki, so "what did
// the server actually answer her phone?" has an answer the next time it is
// asked. One agent, read-only on the Docker socket, labels each line with its
// compose service name — query {app="offwego", service="api"} and read.

discovery.docker "wayfare" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=wayfare"]
  }
}

discovery.relabel "wayfare" {
  targets = discovery.docker.wayfare.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "wayfare" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.wayfare.output
  forward_to = [loki.write.cloud.receiver]
  labels     = { app = "offwego" }
}

loki.write "cloud" {
  endpoint {
    url = env("GRAFANA_LOKI_URL")

    basic_auth {
      username = env("GRAFANA_LOKI_USER")
      password = env("GRAFANA_LOKI_TOKEN")
    }
  }
}

// ---- traces -----------------------------------------------------------
// The api container speaks OTLP to this receiver; spans continue to Grafana
// Cloud Tempo. The Loki datasource's derived traceID field links the two.

otelcol.receiver.otlp "app" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.app.input]
  }
}

otelcol.processor.batch "app" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.auth.basic "tempo" {
  username = env("GRAFANA_TEMPO_USER")
  password = env("GRAFANA_LOKI_TOKEN")
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = env("GRAFANA_TEMPO_URL")
    auth     = otelcol.auth.basic.tempo.handler
  }
}

// ---- the browser ------------------------------------------------------
// The Faro Web SDK posts to /collect on the app's own domain; Caddy hands it
// here. Errors and events become Loki lines, browser spans join the same
// Tempo as the server's, so one trace crosses the wire intact.

faro.receiver "web" {
  server {
    listen_address       = "0.0.0.0"
    listen_port          = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs   = [loki.write.cloud.receiver]
    traces = [otelcol.processor.batch.app.input]
  }
}
