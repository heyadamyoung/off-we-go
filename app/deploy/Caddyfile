{$WAYFARE_DOMAIN} {
  # Not the live stream: compression holds bytes back waiting for more of them,
  # which turns a pushed position into a slow one.
  encode zstd gzip {
    match {
      not header Content-Type text/event-stream*
    }
  }

  handle /.well-known/apple-app-site-association {
    reverse_proxy api:3000
  }

  handle /.well-known/assetlinks.json {
    reverse_proxy api:3000
  }

  handle /.well-known/oauth-authorization-server {
    reverse_proxy api:3000
  }

  handle /.well-known/oauth-protected-resource* {
    reverse_proxy api:3000
  }

  handle /oauth/* {
    reverse_proxy api:3000
  }

  handle /mcp {
    reverse_proxy api:3000
  }

  handle /api/* {
    reverse_proxy api:3000
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
}

www.{$WAYFARE_DOMAIN} {
  redir https://{$WAYFARE_DOMAIN}{uri} permanent
}

wayfare.threadway.ai {
  redir https://{$WAYFARE_DOMAIN}{uri} permanent
}

{$LOGTO_DOMAIN} {
  encode zstd gzip
  reverse_proxy logto:3001

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}

{$LOGTO_ADMIN_DOMAIN} {
  encode zstd gzip
  reverse_proxy logto:3002

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}
