{$WAYFARE_DOMAIN} {
  # Everything but the live stream: compression holds bytes back waiting for
  # more of them, which turns a pushed position into a slow one.
  @compressible not path /api/trips/*/live/stream
  encode @compressible zstd gzip

  handle /.well-known/apple-app-site-association {
    reverse_proxy api:3000
  }

  handle /.well-known/assetlinks.json {
    reverse_proxy api:3000
  }

  handle /.well-known/oauth-authorization-server {
    reverse_proxy api:3000
  }

  handle /.well-known/oauth-protected-resource* {
    reverse_proxy api:3000
  }

  handle /oauth/* {
    reverse_proxy api:3000
  }

  handle /mcp {
    reverse_proxy api:3000
  }

  handle /api/* {
    reverse_proxy api:3000
  }

  # The browser's telemetry (Faro) lands on our own domain and is handed to
  # the alloy agent — first-party, so nothing for a blocker to eat.
  handle /collect* {
    reverse_proxy alloy:12347
  }

  handle {
    root * /srv
    # {path}/ lets a real directory serve its own index.html (the /adhoc/
    # install page) instead of falling through to the app shell.
    try_files {path} {path}/ /index.html
    file_server
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }

  # Freshness is explicit, never heuristic. Without a Cache-Control the
  # browser is allowed to reuse the shell HTML on its own judgement — which
  # pinned a phone to a stale build through a deploy and a refresh. Hashed
  # bundles never change under their names, so they are immutable; everything
  # else answers no-cache (revalidate every use; 304 keeps it cheap). The ? on the
  # default leaves untouched anything that already declared its own policy.
  @hashed path /assets/*
  header @hashed Cache-Control "public, max-age=31536000, immutable"
  header ?Cache-Control "no-cache"
}

www.{$WAYFARE_DOMAIN} {
  redir https://{$WAYFARE_DOMAIN}{uri} permanent
}

wayfare.threadway.ai {
  redir https://{$WAYFARE_DOMAIN}{uri} permanent
}

{$LOGTO_DOMAIN} {
  encode zstd gzip
  reverse_proxy logto:3001

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}

{$LOGTO_ADMIN_DOMAIN} {
  encode zstd gzip
  reverse_proxy logto:3002

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}
