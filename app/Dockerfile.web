FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY vite.config.ts tsconfig.json ./
COPY public ./public
COPY src ./src
# Start prerenders the SPA shell by booting a server on "localhost" and
# fetching it back. In this image "localhost" resolves to ::1 first, while
# node's fetch dials 127.0.0.1 — so the prerender connects to nothing and the
# build dies. Pinning IPv4 puts both ends on the same address.
ENV NODE_OPTIONS=--dns-result-order=ipv4first
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
# The deploy sha rides into the browser's telemetry as app.version — "which
# deploy broke it" is the canonical slicing dimension.
ARG VITE_APP_SHA=dev
ENV VITE_APP_SHA=$VITE_APP_SHA
RUN pnpm build
# A shell that names a file the build did not emit must fail here, not
# silently paint unstyled in front of everybody.
COPY scripts/check-release-assets.mjs ./scripts/
RUN node scripts/check-release-assets.mjs dist/client

FROM caddy:2.10-alpine
COPY --from=build /app/dist/client /srv
