{
  "name": "wayfare-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ios": "vite build --mode ios",
    "preview": "vite preview",
    "test:privacy": "node scripts/check-repository-privacy.mjs",
    "test:unit": "node --test tests/mobile-tracking.test.js tests/vps-api-client.test.js tests/migration-core.test.js tests/deployment-guard.test.js tests/ios-release-config.test.js tests/repository-privacy.test.js",
    "test:server": "node --test server/test/*.test.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "ios:sync": "pnpm build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "seed:attractions": "node scripts/seed-attractions.mjs",
    "migrate:supabase": "node scripts/migrate-from-supabase.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor-community/background-geolocation": "1.2.26",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.3",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/preferences": "8.0.1",
    "@fastify/cors": "11",
    "@fastify/formbody": "9",
    "@fastify/multipart": "10",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "fastify": "5",
    "maplibre-gl": "^6.6.0",
    "nodemailer": "^9.0.6",
    "pg": "8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "~0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2"
  }
}
